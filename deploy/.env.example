# Copy to a private runtime env file and fill in the host paths/secrets.
# The runtime image is the dependency-only release asset. Compose builds the
# application image from the current checkout on this host.
SUPERAGENT_RUNTIME_IMAGE=superagent-sec-runtime:stable
SUPERAGENT_APP_IMAGE=superagent-sec-app:local
# Set this when the imported runtime archive targets a different architecture,
# for example linux/amd64 on an ARM build host.
SUPERAGENT_CONTAINER_PLATFORM=
SUPERAGENT_BIND_HOST=127.0.0.1
SUPERAGENT_HOST_WEB_PORT=3184
SUPERAGENT_PROJECTS_DIR=/srv/superagent-sec/projects
SUPERAGENT_PROJECT_ID=default
SUPERAGENT_DATA_DIR=/srv/superagent-sec/runtime/default
SUPERAGENT_SSH_STRICT_HOST_KEY_CHECKING=accept-new
# Optional complete DSH patch supplied by the operator. Do not put API keys
# in this file unless the runtime file is chmod 600 and kept outside Git.
SUPERAGENT_DSH_PATCH_FILE=
SUPERAGENT_DSH_PATCH_HOST_FILE=./.container-data/dsh.patch.yml
SUPERAGENT_EXTERNAL_ENV_FILE=/srv/superagent-sec/runtime/default/external.env
