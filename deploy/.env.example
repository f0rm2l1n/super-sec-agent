# Copy to a private runtime env file and fill in the host paths/secrets.
SUPERAGENT_IMAGE_TAG=stable
SUPERAGENT_BIND_HOST=127.0.0.1
SUPERAGENT_HOST_WEB_PORT=3184
SUPERAGENT_SOURCE_DIR=/srv/superagent-sec/app
SUPERAGENT_PROJECTS_DIR=/srv/superagent-sec/projects
SUPERAGENT_PROJECT_ID=default
SUPERAGENT_DATA_DIR=/srv/superagent-sec/runtime/default
SUPERAGENT_SSH_STRICT_HOST_KEY_CHECKING=accept-new
DEEPSEEK_API_KEY=
